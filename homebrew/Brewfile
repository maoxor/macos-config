# GUI apps. OmniWM is NOT here: it is built locally with patches (tools/omniwm/build-local.sh);
# the Homebrew cask would replace that build on `brew upgrade`.
tap "y3owk1n/tap"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Desktop automation application
cask "hammerspoon"
# Keyboard driven navigation
cask "y3owk1n/tap/neru", trusted: true
# Control your tools with a few keystrokes
cask "raycast"
# System monitor for the menu bar
cask "stats"
# Browser for the second Claude account (claude2 opens its links there)
cask "google-chrome"

# ChatGPT desktop app (the web version fails to load conversations in Safari)
cask "chatgpt"

# Swift toolchain manager: building OmniWM's upstream main for contributions needs the snapshot pinned in its
# .swift-version (`swiftly install` in the checkout). From Homebrew, not Nix: the proxies in ~/.swiftly/bin link to
# the swiftly binary, and a Nix store path would change on every update.
brew "swiftly"

# Main browser: many tabs in workspaces, tabs idle 10 min unloaded (tools/zen/README.md)
cask "zen"
# Development browser (Chromium engine, uBlock Origin built in); workspace 4 Atelier by OmniWM rule
cask "helium-browser"
# Local AI image upscaler (Real-ESRGAN, free, offline). CLI: /Applications/Upscayl.app/Contents/Resources/bin/upscayl-bin
# -i in -o out -s 4 -m <Resources>/models -n high-fidelity-4x; run it through `jobgate run --gpu`.
cask "upscayl"
# Mozeidon (egovelox, open source, audited 2026-11-04: local IPC only, no network): Raycast lists and switches Zen
# tabs instantly (~60 ms) through its signed Zen add-on and native messaging (tools/zen/README.md).
tap "egovelox/homebrew-mozeidon"
brew "egovelox/mozeidon/mozeidon"
brew "egovelox/mozeidon/mozeidon-native-app"
# Lume (Cua, MIT): macOS VMs on Apple silicon; the "agents" VM where AI agents work without touching the user's screen
# (tools/agents-vm/README.md). Telemetry off: `lume config telemetry disable`.
brew "lume"
# System monitors opened by Raycast "btop" / "macmon" (scripts/geek-monitor): btop = processes, CPU, memory, network;
# macmon = Apple Silicon GPU, power, temperatures without sudo.
brew "btop"
brew "macmon"
# Now playing in the top bar: macOS restricts MediaRemote; media-control goes through its adapter.
brew "media-control"

# Objective-See security tools (free, open source; tools/security/README.md): LuLu outbound firewall, BlockBlock
# persistence alerts, OverSight camera/microphone alerts, KnockKnock autostart scan.
cask "lulu"
cask "blockblock"
cask "oversight"
cask "knockknock"
