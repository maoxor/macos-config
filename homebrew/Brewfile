# GUI apps. OmniWM is NOT here: it is built locally with patches (tools/omniwm/build-local.sh);
# the Homebrew cask would replace that build on `brew upgrade`.
tap "y3owk1n/tap"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Desktop automation application
cask "hammerspoon"
# Keyboard driven navigation
cask "y3owk1n/tap/neru", trusted: true
# Control your tools with a few keystrokes
cask "raycast"
# System monitor for the menu bar
cask "stats"
# Browser for the second Claude account (claude2 opens its links there)
cask "google-chrome"

# ChatGPT desktop app (the web version fails to load conversations in Safari)
cask "chatgpt"

# Swift toolchain manager: building OmniWM's upstream main for contributions needs the snapshot pinned in its
# .swift-version (`swiftly install` in the checkout). From Homebrew, not Nix: the proxies in ~/.swiftly/bin link to
# the swiftly binary, and a Nix store path would change on every update.
brew "swiftly"
