         inFlight = true
+        nativeSnapshotCacheLog.debug("native snapshot refresh of \(items.count, privacy: .public) windows")
         let wanted = Dictionary(items.map { (UInt32($0.handle.windowId), $0) }, uniquingKeysWith: { a, _ in a })
         let displayId = monitor.displayId
         let monitorFrame = monitor.frame
         let scale = NSScreen.screens.first(where: { $0.displayId == displayId })?.backingScaleFactor ?? 2
         Task { @MainActor in
-            defer { self.inFlight = false }
+            defer {
+                self.inFlight = false
+                if let (items, monitor) = self.rerun { self.rerun = nil; self.refresh(items, monitor: monitor) }
+            }
             guard let content = try? await SCShareableContent.excludingDesktopWindows(false, onScreenWindowsOnly: true),
                   let display = content.displays.first(where: { $0.displayID == displayId })
             else { return }
