+    /// Re-snapshots the visible workspace that holds `token` (its title changed: a Safari tab switch), so the next
+    /// swipe back to it starts from its current content (NativeWindowSnapshotCache).
+    func refreshVisibleSnapshots(containing token: WindowToken) {
+        guard NativeWindowSnapshotCache.shared.titleChangeMatters(for: token) else { return }
+        NativeWindowSnapshotCache.shared.refreshSoon { [weak self] in
+            guard let self, self.flight == nil, let controller = self.controller, controller.hasStartedServices,
+                  controller.settings.gestures.workspaceSwipeEnabled,
+                  let workspaceId = controller.workspaceManager.workspace(for: token),
+                  let monitor = controller.workspaceManager.monitor(for: workspaceId),
+                  controller.workspaceManager.activeWorkspace(on: monitor.id)?.id == workspaceId,
+                  let workspace = self.makeWorkspace(workspaceId, monitor: monitor, active: true)
+            else { return nil }
+            return (workspace.items, monitor)
+        }
+    }
