+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 BarutSRB — https://github.com/OmniNull/OmniWM
+
+import CoreGraphics
+@testable import OmniWM
+import XCTest
+
+@MainActor
+final class NativeWindowSnapshotStalenessTests: XCTestCase {
+    private let cache = NativeWindowSnapshotCache()
+    private let token = WindowToken(pid: 4242, windowId: 4243)
+    private let size = CGSize(width: 1025, height: 1293)
+    private var title: String? = "Page A"
+
+    private func image() -> CGImage {
+        let context = CGContext(
+            data: nil, width: 1, height: 1, bitsPerComponent: 8, bytesPerRow: 4,
+            space: CGColorSpaceCreateDeviceRGB(), bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
+        )!
+        return context.makeImage()!
+    }
+
+    override func setUp() async throws {
+        cache.currentTitle = { [unowned self] _ in self.title }
+        cache.store(image(), for: token, size: size)
+    }
+
+    func testSnapshotIsUsedWhileTitleAndSizeAreUnchanged() {
+        XCTAssertNotNil(cache.image(for: token, size: size))
+    }
+
+    func testTabSwitchMakesTheSnapshotStale() {
+        title = "Page B"
+        XCTAssertNil(cache.image(for: token, size: size))
+    }
+
+    func testAnimatedStatusGlyphDoesNotMakeItStale() {
+        title = "◐ config mac"
+        cache.store(image(), for: token, size: size)
+        title = "◑ config mac"
+        XCTAssertNotNil(cache.image(for: token, size: size))
+        title = "✳ config mac"
+        XCTAssertNotNil(cache.image(for: token, size: size))
+    }
+
+    func testOnlyARealTitleChangeAsksForARefresh() {
+        title = "◐ config mac"
+        cache.store(image(), for: token, size: size)
+        title = "◓ config mac"
+        XCTAssertFalse(cache.titleChangeMatters(for: token))
+        title = "Autre page"
+        XCTAssertTrue(cache.titleChangeMatters(for: token))
+    }
+
+    func testResizeStillMakesItStale() {
+        XCTAssertNil(cache.image(for: token, size: CGSize(width: 2058, height: 1293)))
+    }
+}
