 /// only works while the windows are on screen. So the visible workspace is snapshotted at the
 /// first trackpad contact and right after a swipe lands; a destination workspace then uses its
 /// last native snapshot when the window still has the same size, and the live stream otherwise.
+///
+/// A snapshot also goes stale when the content changes at the same size: a Safari tab switched after the
+/// snapshot showed the previous tab during the next swipe, then the right one once the swipe landed
+/// (2026-10-30). The window title is recorded with the image and must still match; a title change on the visible
+/// workspace re-snapshots it (0.3 s after the last change), so the image is current however the user leaves it.
 @MainActor
 final class NativeWindowSnapshotCache {
     static let shared = NativeWindowSnapshotCache()
@@ -22,32 +28,76 @@ final class NativeWindowSnapshotCache {
     private struct Entry {
         let image: CGImage
         let size: CGSize
+        let title: String
     }
 
     private var entries: [WindowToken: Entry] = [:]
     private var inFlight = false
+    private var rerun: ([WorkspaceSwipePreview.Item], Monitor)?
+    private var pendingRefresh: DispatchWorkItem?
+    /// Replaced by tests.
+    var currentTitle: (UInt32) -> String? = { SkyLight.shared.getWindowTitle($0) }
 
     func image(for token: WindowToken, size: CGSize) -> CGImage? {
         guard let entry = entries[token],
               abs(entry.size.width - size.width) < 1, abs(entry.size.height - size.height) < 1
         else { return nil }
+        guard entry.title == Self.comparableTitle(currentTitle(UInt32(token.windowId))) else {
+            nativeSnapshotCacheLog.debug("stale native snapshot for window \(token.windowId, privacy: .public): title changed")
+            return nil
+        }
         return entry.image
     }
 
+    /// Ghostty titles carry an animated status glyph (Claude Code: ◐ ◑ ◒ ◓ ✳) that changes every second while the
+    /// content barely does: leading non-alphanumerics are not compared.
+    static func comparableTitle(_ title: String?) -> String {
+        String((title ?? "").drop { !$0.isLetter && !$0.isNumber })
+    }
+
+    /// A title change that matters for the snapshot: not the animated status glyph of a terminal (those come every
+    /// second and kept postponing the refresh).
+    func titleChangeMatters(for token: WindowToken) -> Bool {
+        entries[token]?.title != Self.comparableTitle(currentTitle(UInt32(token.windowId)))
+    }
+
+    /// Coalesces bursts (a page load retitles its window several times): one snapshot 0.3 s after the last call.
+    func refreshSoon(_ make: @escaping @MainActor () -> ([WorkspaceSwipePreview.Item], Monitor)?) {
+        pendingRefresh?.cancel()
+        let work = DispatchWorkItem { [weak self] in
+            MainActor.assumeIsolated {
+                guard let self, let (items, monitor) = make() else { return }
+                self.refresh(items, monitor: monitor)
+            }
+        }
+        pendingRefresh = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.3, execute: work)
+    }
+
+    func store(_ image: CGImage, for token: WindowToken, size: CGSize) {
+        entries[token] = Entry(image: image, size: size, title: Self.comparableTitle(currentTitle(UInt32(token.windowId))))
+    }
+
     func remove(_ token: WindowToken) {
         entries.removeValue(forKey: token)
     }
 
     /// Snapshots `items` (frames in AppKit screen coordinates) as currently shown on `monitor`.
     func refresh(_ items: [WorkspaceSwipePreview.Item], monitor: Monitor) {
-        guard !items.isEmpty, !inFlight, ScreenCapturePermissionMonitor.shared.isGranted else { return }
+        guard !items.isEmpty, ScreenCapturePermissionMonitor.shared.isGranted else { return }
