From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: YamadaBlog <118530756+YamadaBlog@users.noreply.github.com>
Date: Sat, 10 Oct 2026 20:51:25 +0200
Subject: [PATCH 09/30] Wallpaper cache: drop the captured wallpaper when the
 desktop picture changes

The SkyLight wallpaper capture was keyed by display frame only, so after a
wallpaper change workspace swipes, drop transitions and the Overview kept
showing the old picture until the display frame changed.

(cherry picked from commit 11a42284069e6d32fa9348163dbda074f037444a)
---
 .../Core/Overview/OverviewWallpaperCache.swift | 14 ++++++++++----
 .../OverviewWallpaperCacheTests.swift          | 18 ++++++++++++++++++
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/Sources/OmniWM/Core/Overview/OverviewWallpaperCache.swift b/Sources/OmniWM/Core/Overview/OverviewWallpaperCache.swift
index df6bea98..e7eaea32 100644
--- a/Sources/OmniWM/Core/Overview/OverviewWallpaperCache.swift
+++ b/Sources/OmniWM/Core/Overview/OverviewWallpaperCache.swift
@@ -13,11 +13,14 @@ final class OverviewWallpaperCache {
 
     private final class Capture {
         let frame: CGRect
+        /// Wallpaper file shown when captured: a capture is stale once the wallpaper changes.
+        let url: URL?
         var unavailable = false
         var thumbnails: [Int: CGImage] = [:]
 
-        init(frame: CGRect) {
+        init(frame: CGRect, url: URL?) {
             self.frame = frame
+            self.url = url
         }
     }
 
@@ -51,13 +54,16 @@ final class OverviewWallpaperCache {
     }
 
     func hasCapturedImage(for displayId: CGDirectDisplayID, maxPixelSize: Int, frame: CGRect) -> Bool {
-        guard let capture = capturesByDisplay[displayId], capture.frame == frame else { return false }
+        guard let capture = capturesByDisplay[displayId], capture.frame == frame,
+              capture.url == desktopImageURL(displayId)
+        else { return false }
         return capture.thumbnails.keys.contains { $0 >= maxPixelSize }
     }
 
     private func capturedImage(for displayId: CGDirectDisplayID, frame: CGRect, maxPixelSize: Int) -> CGImage? {
-        if capturesByDisplay[displayId]?.frame != frame {
-            capturesByDisplay[displayId] = Capture(frame: frame)
+        let url = desktopImageURL(displayId)
+        if capturesByDisplay[displayId]?.frame != frame || capturesByDisplay[displayId]?.url != url {
+            capturesByDisplay[displayId] = Capture(frame: frame, url: url)
         }
         guard let capture = capturesByDisplay[displayId] else { return nil }
         if let thumbnail = capture.thumbnails[maxPixelSize] { return thumbnail }
diff --git a/Tests/OmniWMTests/OverviewWallpaperCacheTests.swift b/Tests/OmniWMTests/OverviewWallpaperCacheTests.swift
index b22913e6..b3bd65dc 100644
--- a/Tests/OmniWMTests/OverviewWallpaperCacheTests.swift
+++ b/Tests/OmniWMTests/OverviewWallpaperCacheTests.swift
@@ -110,6 +110,24 @@ final class OverviewWallpaperCacheTests: XCTestCase {
         )
     }
 
+    func testWallpaperChangeInvalidatesCapturedImage() throws {
+        let black = try makeSolidImage(gray: 0)
+        let white = try makeSolidImage(gray: 1)
+        var desktop = black
+        var url = URL(fileURLWithPath: "/tmp/first.png")
+        let frame = CGRect(x: 0, y: 0, width: 400, height: 200)
+        let cache = OverviewWallpaperCache()
+        cache.desktopImageURL = { _ in url }
+        cache.captureWallpaper = { _ in desktop }
+        try assertGray(cache.image(for: 999, maxPixelSize: 64, frame: frame), equals: 0)
+        XCTAssertTrue(cache.hasCapturedImage(for: 999, maxPixelSize: 64, frame: frame))
+
+        desktop = white
+        url = URL(fileURLWithPath: "/tmp/second.png")
+        XCTAssertFalse(cache.hasCapturedImage(for: 999, maxPixelSize: 64, frame: frame))
+        try assertGray(cache.image(for: 999, maxPixelSize: 64, frame: frame), equals: 1)
+    }
+
     func testUnavailableCaptureFallsBackToFileAndRetriesNextSession() throws {
         let url = FileManager.default.temporaryDirectory.appendingPathComponent("\(UUID().uuidString).png")
         defer { try? FileManager.default.removeItem(at: url) }
