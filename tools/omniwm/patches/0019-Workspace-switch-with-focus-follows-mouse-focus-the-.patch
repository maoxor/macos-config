From: YamadaBlog <118530756+YamadaBlog@users.noreply.github.com>
Date: Fri, 16 Oct 2026 11:37:55 +0200
Subject: [PATCH 18/30] Workspace switch: with focus follows mouse, focus the
 window landing under the pointer, not the remembered one

---
 ...aceNavigationHandler+TransitionFocus.swift | 35 ++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

diff --git a/Sources/OmniWM/Core/Controller/WorkspaceNavigationHandler+TransitionFocus.swift b/Sources/OmniWM/Core/Controller/WorkspaceNavigationHandler+TransitionFocus.swift
index 76ed885f..1fb3142f 100644
--- a/Sources/OmniWM/Core/Controller/WorkspaceNavigationHandler+TransitionFocus.swift
+++ b/Sources/OmniWM/Core/Controller/WorkspaceNavigationHandler+TransitionFocus.swift
@@ -20,7 +20,13 @@ extension WorkspaceNavigationHandler {
                 shouldClearManagedFocus: false
             )
         }
-        let focusToken = controller.resolveAndSetWorkspaceFocusToken(for: workspaceId)
+        var focusToken = controller.resolveAndSetWorkspaceFocusToken(for: workspaceId)
+        // Focus follows the mouse: the window that will land under the pointer wins over the window remembered
+        // for this workspace. Without this, W1 o1 -> W2 -> pointer to o2 -> back to W1 re-focused o1 although
+        // the pointer was over o2 (2026-10-16). Decided here, once, for gestures and keyboard switches alike.
+        if controller.focusFollowsMouseEnabled, let underPointer = windowLandingUnderPointer(in: workspaceId) {
+            focusToken = underPointer
+        }
         let shouldClearManagedFocus = focusToken == nil && controller.workspaceManager.entries(in: workspaceId).isEmpty
         return WorkspaceTransitionFocusHandoff(
             focusToken: focusToken,
@@ -28,6 +34,33 @@ extension WorkspaceNavigationHandler {
         )
     }
 
+    /// Managed window of `workspaceId` whose destination frame (as laid out once the workspace is active)
+    /// contains the pointer; floating windows first since they sit above tiles.
+    private func windowLandingUnderPointer(in workspaceId: WorkspaceDescriptor.ID) -> WindowToken? {
+        guard let controller, let monitor = controller.workspaceManager.monitor(for: workspaceId) else { return nil }
+        let pointer = NSEvent.mouseLocation
+        let manager = controller.workspaceManager
+        let refresh = controller.layoutRefreshController
+        let entries = manager.entries(in: workspaceId).filter { !manager.isWindowSuppressedByMacOS($0.token) }
+        for entry in entries where entry.mode == .floating {
+            if let frame = manager.resolvedFloatingFrame(for: entry.token, preferredMonitor: monitor), frame.contains(pointer) {
+                return entry.token
+            }
+        }
+        let frames: [WindowToken: CGRect] = manager.withEngineMutationScope {
+            if manager.activeLayoutKind(for: workspaceId) == .niri {
+                return refresh.niriHandler.settledFrames(in: workspaceId, visibleOnly: true) ?? [:]
+            }
+            guard let engine = controller.dwindleEngine,
+                  let snapshot = refresh.dwindleHandler.makeWorkspaceSnapshot(
+                      workspaceId: workspaceId, monitor: monitor, resolveConstraints: false, isActiveWorkspace: true
+                  ) else { return [:] }
+            let plan = refresh.dwindleHandler.buildOnDemandLayoutPlan(snapshot: snapshot, engine: engine)
+            return Dictionary(plan.diff.frameChanges.map { ($0.token, $0.frame) }, uniquingKeysWith: { _, last in last })
+        }
+        return entries.first { $0.mode != .floating && frames[$0.token]?.contains(pointer) == true }?.token
+    }
+
     func clearManagedFocusAfterEmptyWorkspaceSwitch() {
         guard let controller else { return }
         let canceledRequest = controller.intentLedger.cancelManagedRequest()
