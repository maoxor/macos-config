From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: maoxor <118530756+maoxor@users.noreply.github.com>
Date: Wed, 4 Nov 2026 00:07:37 +0100
Subject: [PATCH 30/30] Focus follows mouse: re-evaluations never drop
 silently, a policy denial is retried, 40 ms debounce

The trailing-edge re-evaluation re-ran the debounce check with a Date that could be a hair short of the dispatch
deadline and dropped silently when the latest sample was gone, so the window under a stopped pointer stayed
unfocused until the next move. It now skips the debounce, falls back to the live pointer, and traces every drop.
A hover denied by a short policy lease (0.4 s after an app switch) is retried every 50 ms for up to 1 s.
The debounce goes from 0.1 s to 0.04 s.
---
 .../MouseEventHandler+FocusFollowsMouse.swift | 76 +++++++++++++++----
 .../Core/Controller/MouseInputState.swift     |  4 +-
 2 files changed, 65 insertions(+), 15 deletions(-)

diff --git a/Sources/OmniWM/Core/Controller/MouseEventHandler+FocusFollowsMouse.swift b/Sources/OmniWM/Core/Controller/MouseEventHandler+FocusFollowsMouse.swift
index e398410f..476aa2d4 100644
--- a/Sources/OmniWM/Core/Controller/MouseEventHandler+FocusFollowsMouse.swift
+++ b/Sources/OmniWM/Core/Controller/MouseEventHandler+FocusFollowsMouse.swift
@@ -130,8 +130,13 @@ extension MouseEventHandler {
         controller?.ownedWindowRegistry.contains(point: location, excluding: SurfaceKind.gestureTransparent) == true
     }
 
-    private func handleFocusFollowsMouse(at location: CGPoint, windowIdUnderPointer: Int?) {
+    private func handleFocusFollowsMouse(
+        at location: CGPoint,
+        windowIdUnderPointer: Int?,
+        isReevaluation: Bool = false
+    ) {
         guard let controller else { return }
+        if !isReevaluation { FocusFollowsMouseTrailingEdge.retries = 0 }
         guard !externalFocusBlocksFocusFollowsMouse,
               !hasPendingNativeFullscreenTransition(at: location),
               !isPointerDisplayShowingFullscreenSpace(at: location)
@@ -142,22 +147,18 @@ extension MouseEventHandler {
 
         let now = Date()
         let elapsed = now.timeIntervalSince(state.lastFocusFollowsMouseTime)
-        guard elapsed >= state.focusFollowsMouseDebounce else {
+        // A re-evaluation runs once the debounce has expired by construction: comparing a Date with the
+        // dispatch deadline could find it a hair short and silently re-arm (2026-11-04).
+        guard isReevaluation || elapsed >= state.focusFollowsMouseDebounce else {
             // Trailing edge: a move dropped by the debounce was never retried, so a pointer that arrived
             // quickly and stopped stayed on an unfocused window (8 of 15 fast stops, old and new builds
             // alike, 2026-10-16). Re-evaluate once, when the debounce expires, at the latest position.
             FocusTrace.decision("debounced: re-evaluate when it expires", controller: controller)
-            FocusFollowsMouseTrailingEdge.schedule(after: state.focusFollowsMouseDebounce - elapsed) { [weak self] in
-                guard let self, let controller = self.controller,
-                      controller.focusFollowsMouseEnabled, !controller.isOverviewOpen()
-                else { return }
-                guard let sample = self.state.latestFocusFollowsMouseSample,
-                      !controller.settings.focus.lockModifier.isHeld(inRawFlags: sample.modifiersRawValue),
-                      !self.shouldBlockOwnWindowInput(at: sample.location, windowIdUnderPointer: sample.windowIdUnderPointer),
-                      self.shouldHandleFocusFollowsMouse(at: sample.location)
-                else { return }
-                self.handleFocusFollowsMouse(at: sample.location, windowIdUnderPointer: sample.windowIdUnderPointer)
-            }
+            scheduleFocusFollowsMouseReevaluation(
+                after: state.focusFollowsMouseDebounce - elapsed,
+                location: location,
+                windowIdUnderPointer: windowIdUnderPointer
+            )
             return
         }
         FocusFollowsMouseTrailingEdge.cancel()
@@ -199,6 +200,51 @@ extension MouseEventHandler {
             activateFocusFollowsMouseTarget(target)
         }
         FocusTrace.decision(allowed ? "focus requested" : "skip: focus policy denied", controller: controller, token: token)
+        // A short policy lease (an app switch holds one for 0.4 s) denied the hover: nothing retried it, so the
+        // window under a still pointer waited for the next mouse move. Retry every 50 ms while it lasts, 1 s at
+        // most (2026-11-04).
+        if !allowed, FocusFollowsMouseTrailingEdge.retries < 20 {
+            FocusFollowsMouseTrailingEdge.retries += 1
+            scheduleFocusFollowsMouseReevaluation(
+                after: 0.05,
+                location: location,
+                windowIdUnderPointer: windowIdUnderPointer
+            )
+        }
+    }
+
+    /// Re-run the hover decision later at the latest pointer sample (the one given here if the tap has none),
+    /// replacing any pending re-evaluation. Every drop is traced, so a window left unfocused shows why.
+    private func scheduleFocusFollowsMouseReevaluation(
+        after delay: TimeInterval,
+        location: CGPoint,
+        windowIdUnderPointer: Int?
+    ) {
+        FocusFollowsMouseTrailingEdge.schedule(after: delay) { [weak self] in
+            guard let self, let controller = self.controller else { return }
+            guard controller.focusFollowsMouseEnabled, !controller.isOverviewOpen() else {
+                FocusTrace.decision("re-evaluation dropped: focus follows mouse off or Overview open", controller: controller)
+                return
+            }
+            // No sample (cleared by an app visibility change): ask the pointer where it is now, so the
+            // decision is never taken at a position the pointer has left.
+            let sample = self.state.latestFocusFollowsMouseSample
+            let at = sample?.location ?? CGEvent(source: nil)?.location ?? location
+            let windowId = sample.map(\.windowIdUnderPointer) ?? nil
+            if let sample, controller.settings.focus.lockModifier.isHeld(inRawFlags: sample.modifiersRawValue) {
+                FocusTrace.decision("re-evaluation dropped: lock modifier held", controller: controller)
+                return
+            }
+            guard !self.shouldBlockOwnWindowInput(at: at, windowIdUnderPointer: windowId) else {
+                FocusTrace.decision("re-evaluation dropped: pointer over an OmniWM surface", controller: controller)
+                return
+            }
+            guard self.shouldHandleFocusFollowsMouse(at: at) else {
+                FocusTrace.decision("re-evaluation dropped: move/resize, swipe or scroll running", controller: controller)
+                return
+            }
+            self.handleFocusFollowsMouse(at: at, windowIdUnderPointer: windowId, isReevaluation: true)
+        }
     }
 
     func hasPendingNativeFullscreenTransition(at location: CGPoint) -> Bool {
@@ -365,7 +411,7 @@ extension MouseEventHandler {
               controller.isEnabled,
               controller.focusFollowsMouseEnabled,
               !controller.isOverviewOpen(),
-              !shouldBlockOwnWindowInput(at: sample.location),
+              !shouldBlockOwnWindowInput(at: sample.location, windowIdUnderPointer: sample.windowIdUnderPointer),
               !controller.settings.focus.lockModifier.isHeld(inRawFlags: sample.modifiersRawValue),
               !state.isMoving,
               !state.isResizing,
@@ -460,6 +506,8 @@ enum NativeFocusCheck {
 @MainActor
 enum FocusFollowsMouseTrailingEdge {
     private static var pending: DispatchWorkItem?
+    /// Retries after a policy denial since the last real mouse move.
+    static var retries = 0
 
     static func schedule(after delay: TimeInterval, _ body: @escaping @MainActor () -> Void) {
         pending?.cancel()
diff --git a/Sources/OmniWM/Core/Controller/MouseInputState.swift b/Sources/OmniWM/Core/Controller/MouseInputState.swift
index f39f738b..11f9a813 100644
--- a/Sources/OmniWM/Core/Controller/MouseInputState.swift
+++ b/Sources/OmniWM/Core/Controller/MouseInputState.swift
@@ -118,7 +118,9 @@ struct MouseInputState {
 
     var lastFocusFollowsMouseTime: Date = .distantPast
     var latestFocusFollowsMouseSample: FocusFollowsMouseSample?
-    let focusFollowsMouseDebounce: TimeInterval = 0.1
+    /// Minimum gap between two hover focus changes; a move inside it is re-evaluated when it expires.
+    /// 0.1 s felt slow from one terminal to the next (2026-11-04); 0.04 s still skips windows merely crossed.
+    let focusFollowsMouseDebounce: TimeInterval = 0.04
     var dragGhostController: DragGhostController?
 
     var gesturePhase: GesturePhase = .idle
