From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: YamadaBlog <118530756+YamadaBlog@users.noreply.github.com>
Date: Thu, 15 Oct 2026 17:36:24 +0200
Subject: [PATCH 07/30] Swipe preview: log whether each window used a native
 snapshot or the stream capture

---
 Sources/OmniWM/Core/Surface/WorkspaceSwipePreview.swift | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Sources/OmniWM/Core/Surface/WorkspaceSwipePreview.swift b/Sources/OmniWM/Core/Surface/WorkspaceSwipePreview.swift
index e7528a47..e7c908ff 100644
--- a/Sources/OmniWM/Core/Surface/WorkspaceSwipePreview.swift
+++ b/Sources/OmniWM/Core/Surface/WorkspaceSwipePreview.swift
@@ -2,6 +2,7 @@
 // Copyright (C) 2026 OmniNull — https://github.com/OmniNull/OmniWM
 
 import AppKit
+import OSLog
 import IOSurface
 import QuartzCore
 
@@ -353,9 +354,11 @@ extension WorkspaceSwipePreview {
                 still.contentsGravity = .resize
                 still.contents = native
                 layer.addSublayer(still)
+                nativeSnapshotLog.debug("native snapshot used for window \(item.token.windowId, privacy: .public)")
                 continue
             }
             guard let preview = capture.preview(for: item.handle) else { continue }
+            nativeSnapshotLog.debug("stream capture used for window \(item.token.windowId, privacy: .public)")
             let content = Content(
                 preview: preview,
                 frame: item.frame.offsetBy(dx: -frame.minX, dy: -frame.minY),
@@ -428,3 +431,5 @@ private final class WorkspaceSwipePreviewPanel: NSPanel {
         false
     }
 }
+
+private let nativeSnapshotLog = Logger(subsystem: "com.barut.OmniWM", category: "swipe-snapshot")
-- 
