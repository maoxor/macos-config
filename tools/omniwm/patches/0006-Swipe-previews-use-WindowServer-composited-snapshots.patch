diff --git a/Sources/OmniWM/Core/Surface/NativeWindowSnapshotCache.swift b/Sources/OmniWM/Core/Surface/NativeWindowSnapshotCache.swift
new file mode 100644
index 00000000..62c40746
--- /dev/null
+++ b/Sources/OmniWM/Core/Surface/NativeWindowSnapshotCache.swift
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 BarutSRB — https://github.com/OmniNull/OmniWM
+
+import AppKit
+import ScreenCaptureKit
+
+/// Window images composited by the WindowServer exactly as they appear on screen.
+///
+/// Swipe previews stream each window with `SCContentFilter(desktopIndependentWindow:)`. For a
+/// window with a backdrop blur (Ghostty `background-blur` + `background-opacity`) that capture
+/// replaces the live blur with an opaque neutral material: measured on 2026-10-15, a Ghostty
+/// window averaged sRGB (0.192, 0.116, 0.200) on screen but (0.225, 0.154, 0.234) captured, so
+/// the windows looked washed out for the whole swipe. A display capture that includes only the
+/// wallpaper and the workspace's windows is composited like the screen (measured identical), but it
+/// only works while the windows are on screen. So the visible workspace is snapshotted at the
+/// first trackpad contact and right after a swipe lands; a destination workspace then uses its
+/// last native snapshot when the window still has the same size, and the live stream otherwise.
+@MainActor
+final class NativeWindowSnapshotCache {
+    static let shared = NativeWindowSnapshotCache()
+
+    private struct Entry {
+        let image: CGImage
+        let size: CGSize
+    }
+
+    private var entries: [WindowToken: Entry] = [:]
+    private var inFlight = false
+
+    func image(for token: WindowToken, size: CGSize) -> CGImage? {
+        guard let entry = entries[token],
+              abs(entry.size.width - size.width) < 1, abs(entry.size.height - size.height) < 1
+        else { return nil }
+        return entry.image
+    }
+
+    func remove(_ token: WindowToken) {
+        entries.removeValue(forKey: token)
+    }
+
+    /// Snapshots `items` (frames in AppKit screen coordinates) as currently shown on `monitor`.
+    func refresh(_ items: [WorkspaceSwipePreview.Item], monitor: Monitor) {
+        guard !items.isEmpty, !inFlight, ScreenCapturePermissionMonitor.shared.isGranted else { return }
+        inFlight = true
+        let wanted = Dictionary(items.map { (UInt32($0.handle.windowId), $0) }, uniquingKeysWith: { a, _ in a })
+        let displayId = monitor.displayId
+        let monitorFrame = monitor.frame
+        let scale = NSScreen.screens.first(where: { $0.displayId == displayId })?.backingScaleFactor ?? 2
+        Task { @MainActor in
+            defer { self.inFlight = false }
+            guard let content = try? await SCShareableContent.excludingDesktopWindows(false, onScreenWindowsOnly: true),
+                  let display = content.displays.first(where: { $0.displayID == displayId })
+            else { return }
+            let windows = content.windows.filter { wanted[$0.windowID] != nil }
+            guard !windows.isEmpty else { return }
+            let wallpaper = content.windows.filter { ($0.title ?? "").hasPrefix("Wallpaper") }
+            let config = SCStreamConfiguration()
+            config.width = Int(CGFloat(display.width) * scale)
+            config.height = Int(CGFloat(display.height) * scale)
+            config.showsCursor = false
+            config.captureDynamicRange = .SDR
+            let filter = SCContentFilter(display: display, including: wallpaper + windows)
+            guard let image = try? await SCScreenshotManager.captureImage(contentFilter: filter, configuration: config)
+            else { return }
+            let pxScale = CGFloat(image.width) / monitorFrame.width
+            for window in windows {
+                guard let item = wanted[window.windowID] else { continue }
+                // Only a window that is really shown where the item says, fully on this display:
+                // a parked, moving or partly off-screen window would yield wallpaper or a cut image.
+                let primaryHeight = NSScreen.screens.first?.frame.height ?? monitorFrame.height
+                let expected = CGRect(
+                    x: item.frame.minX, y: primaryHeight - item.frame.maxY,
+                    width: item.frame.width, height: item.frame.height
+                )
+                guard window.isOnScreen,
+                      abs(window.frame.minX - expected.minX) < 2, abs(window.frame.minY - expected.minY) < 2,
+                      abs(window.frame.width - expected.width) < 2, abs(window.frame.height - expected.height) < 2,
+                      monitorFrame.contains(item.frame.insetBy(dx: 0.5, dy: 0.5))
+                else { continue }
+                let crop = CGRect(
+                    x: (item.frame.minX - monitorFrame.minX) * pxScale,
+                    y: (monitorFrame.maxY - item.frame.maxY) * pxScale,
+                    width: item.frame.width * pxScale,
+                    height: item.frame.height * pxScale
+                ).integral
+                if let slice = image.cropping(to: crop) {
+                    self.entries[item.handle.token] = Entry(image: slice, size: item.frame.size)
+                }
+            }
+        }
+    }
+}
