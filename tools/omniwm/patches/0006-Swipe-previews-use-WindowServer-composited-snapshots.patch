     }
 
     func prepare(source: [Item], destination: [Item], monitor: Monitor, workingFrame: CGRect? = nil) {
+        NativeWindowSnapshotCache.shared.refresh(source, monitor: monitor)
         reconcile(
             source: source,
             destination: destination,
@@ -230,6 +231,7 @@ final class WorkspaceSwipePreview {
         root.addSublayer(destinationLayer)
         self.sourceLayer = sourceLayer
         self.destinationLayer = destinationLayer
+        landedItems = (destination, monitor)
         self.panel = panel
         CATransaction.commit()
 
@@ -297,9 +299,19 @@ final class WorkspaceSwipePreview {
         CATransaction.commit()
     }
 
+    private var landedItems: ([Item], Monitor)?
+
     func stop() {
         isWarming = false
         dropSourceSnapshot()
+        if let (items, monitor) = landedItems {
+            landedItems = nil
+            // Whichever workspace ends up visible, its windows are on screen ~0.6 s later.
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.6) { [weak self] in
+                guard self?.panel == nil else { return }
+                NativeWindowSnapshotCache.shared.refresh(items, monitor: monitor)
+            }
+        }
         let previous = contents.values.flatMap { $0.map(\.preview) }
         CATransaction.begin()
         CATransaction.setDisableActions(true)
@@ -334,6 +346,15 @@ extension WorkspaceSwipePreview {
         layer.masksToBounds = true
         layer.addSublayer(makeWallpaperLayer(image, monitor: monitor, frame: frame))
         for item in items {
+            if let native = NativeWindowSnapshotCache.shared.image(for: item.token, size: item.frame.size) {
+                let still = CALayer()
+                still.frame = item.frame.offsetBy(dx: -frame.minX, dy: -frame.minY)
+                still.contentsScale = scale
+                still.contentsGravity = .resize
+                still.contents = native
+                layer.addSublayer(still)
+                continue
+            }
             guard let preview = capture.preview(for: item.handle) else { continue }
             let content = Content(
                 preview: preview,
