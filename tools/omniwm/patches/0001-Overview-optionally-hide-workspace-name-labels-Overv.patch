From: YamadaBlog <118530756+YamadaBlog@users.noreply.github.com>
Date: Thu, 15 Oct 2026 16:24:07 +0200
Subject: [PATCH 01/30] Overview: optionally hide workspace name labels
 (OverviewHideWorkspaceLabels default)

---
 .../Overview/OverviewLayerRenderer+Chrome.swift    | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/Sources/OmniWM/Core/Overview/OverviewLayerRenderer+Chrome.swift b/Sources/OmniWM/Core/Overview/OverviewLayerRenderer+Chrome.swift
index bcc82a92..fcd17f45 100644
--- a/Sources/OmniWM/Core/Overview/OverviewLayerRenderer+Chrome.swift
+++ b/Sources/OmniWM/Core/Overview/OverviewLayerRenderer+Chrome.swift
@@ -21,12 +21,14 @@ extension OverviewLayerRenderer {
             workspaceChrome.addSublayer(sectionLayer)
             chromeSections[section.workspaceId] = sectionLayer
             addRibbon(for: section, frame: layout.backgroundFrame(for: section), to: sectionLayer)
-            let color = section.isActive ? Colors.workspaceLabelActive : Colors.workspaceLabelInactive
-            let label = OverviewRenderer.textLayer(size: 16, color: color)
-            label.string = section.name
-            label.frame = section.labelFrame
-            label.contentsScale = contentsScale
-            sectionLayer.addSublayer(label)
+            if !UserDefaults.standard.bool(forKey: "OverviewHideWorkspaceLabels") {
+                let color = section.isActive ? Colors.workspaceLabelActive : Colors.workspaceLabelInactive
+                let label = OverviewRenderer.textLayer(size: 16, color: color)
+                label.string = section.name
+                label.frame = section.labelFrame
+                label.contentsScale = contentsScale
+                sectionLayer.addSublayer(label)
+            }
             addColumnChrome(section, layout: layout, to: sectionLayer)
             for control in layout.tabControls(for: section) {
                 guard let window = layout.window(for: control.handle),
