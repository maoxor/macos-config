+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 BarutSRB — https://github.com/OmniNull/OmniWM
+
+import AppKit
+import OSLog
+
+private let benchLog = Logger(subsystem: "com.barut.OmniWM", category: "column-scroll-bench")
+
+/// Reproducible 3-finger horizontal column scroll for measurements: `notifyutil -p com.barut.OmniWM.bench.columnScroll`
+/// replays the same gesture (120 Hz frames through the real gesture pipeline) at the screen centre. Segments are
+/// (normalized trackpad x velocity per second, duration): slow drag, fast drag, direction reversal, fast flick, lift.
+@MainActor
+final class ColumnScrollBench {
+    static let notification = "com.barut.OmniWM.bench.columnScroll"
+    private static let segments: [(velocity: CGFloat, duration: TimeInterval)] = [
+        (-0.25, 0.8), (-0.9, 0.5), (0.9, 0.5), (0.25, 0.6), (-1.6, 0.15),
+    ]
+    private weak var handler: MouseEventHandler?
+    private var timer: Timer?
+    private var plan: [(time: TimeInterval, x: CGFloat)] = []
+    private var index = 0
+    private var start: TimeInterval = 0
+    private var location: CGPoint = .zero
+
+    init(handler: MouseEventHandler) {
+        self.handler = handler
+        let observer = Unmanaged.passUnretained(self).toOpaque()
+        CFNotificationCenterAddObserver(
+            CFNotificationCenterGetDarwinNotifyCenter(), observer,
+            { _, observer, _, _, _ in
+                guard let observer else { return }
+                let bench = Unmanaged<ColumnScrollBench>.fromOpaque(observer).takeUnretainedValue()
+                DispatchQueue.main.async { MainActor.assumeIsolated { bench.run() } }
+            },
+            Self.notification as CFString, nil, .deliverImmediately
+        )
+    }
+
+    func run() {
+        guard timer == nil, let screen = NSScreen.main else { return }
+        let frame = screen.frame
+        location = CGPoint(x: frame.midX, y: frame.midY)
+        plan = []
+        var t: TimeInterval = 0, x: CGFloat = 0.5
+        let dt = 1.0 / 120.0
+        for segment in Self.segments {
+            var elapsed: TimeInterval = 0
+            while elapsed < segment.duration {
+                t += dt; elapsed += dt; x += segment.velocity * CGFloat(dt)
+                plan.append((t, x))
+            }
+        }
+        index = 0
+        start = CACurrentMediaTime()
+        benchLog.notice("bench start: \(self.plan.count, privacy: .public) frames")
+        send(.began, x: 0.5, at: start)
+        timer = Timer.scheduledTimer(withTimeInterval: dt, repeats: true) { [weak self] _ in
+            MainActor.assumeIsolated { self?.step() }
+        }
+    }
+
+    private func step() {
+        let now = CACurrentMediaTime()
+        // Send every planned frame that is due (a late timer delivers the backlog like the real event tap).
+        while index < plan.count, start + plan[index].time <= now {
+            send(.changed, x: plan[index].x, at: start + plan[index].time)
+            index += 1
+        }
+        guard index >= plan.count else { return }
+        timer?.invalidate(); timer = nil
+        send(.ended, x: 0, at: now + 0.008)
+        benchLog.notice("bench end")
+    }
+
+    private func send(_ phase: NSEvent.Phase, x: CGFloat, at time: TimeInterval) {
+        let touches = phase == .ended ? [] : (0 ..< 3).map { finger in
+            MouseEventHandler.GestureTouchSample(
+                phase: .moved, normalizedPosition: CGPoint(x: x + CGFloat(finger) * 0.05, y: 0.5)
+            )
+        }
+        handler?.receiveTapGestureEvent(MouseEventHandler.GestureEventSnapshot(
+            location: location, phaseRawValue: phase.rawValue, timestamp: time, touches: touches
+        ))
+    }
+}
