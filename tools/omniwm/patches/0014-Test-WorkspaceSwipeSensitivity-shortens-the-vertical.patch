 1 file changed, 26 insertions(+)
 create mode 100644 Tests/OmniWMTests/WorkspaceSwipeResponsivenessTests.swift

diff --git a/Tests/OmniWMTests/WorkspaceSwipeResponsivenessTests.swift b/Tests/OmniWMTests/WorkspaceSwipeResponsivenessTests.swift
new file mode 100644
index 00000000..d275c4eb
--- /dev/null
+++ b/Tests/OmniWMTests/WorkspaceSwipeResponsivenessTests.swift
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 BarutSRB — https://github.com/OmniNull/OmniWM
+
+@testable import OmniWM
+import XCTest
+
+/// Regression (2026-10-16): the vertical workspace swipe started late again after a rebuild that dropped the
+/// WorkspaceSwipeSensitivity option. The setting must shorten both the travel per workspace and the trigger.
+final class WorkspaceSwipeResponsivenessTests: XCTestCase {
+    private let key = "WorkspaceSwipeSensitivity"
+    override func tearDown() { UserDefaults.standard.removeObject(forKey: key); super.tearDown() }
+
+    func testSensitivityShortensTriggerAndTravel() {
+        UserDefaults.standard.removeObject(forKey: key)
+        let defaultTrigger = TrackpadGestureIntent.workspaceSwipeTriggerUnits
+        let defaultTravel = WorkspaceSwipeMotion.travelUnits
+        UserDefaults.standard.set(1.8, forKey: key)
+        XCTAssertLessThan(TrackpadGestureIntent.workspaceSwipeTriggerUnits, defaultTrigger * 0.6)
+        XCTAssertLessThan(WorkspaceSwipeMotion.travelUnits, defaultTravel * 0.6)
+    }
+
+    func testOutOfRangeValuesAreClamped() {
+        UserDefaults.standard.set(100.0, forKey: key)
+        XCTAssertEqual(WorkspaceSwipeMotion.sensitivity, 3)
+    }
+}
