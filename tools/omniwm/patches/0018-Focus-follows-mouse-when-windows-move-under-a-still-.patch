diff --git a/Sources/OmniWM/Core/Controller/MouseEventHandler+FocusFollowsMouse.swift b/Sources/OmniWM/Core/Controller/MouseEventHandler+FocusFollowsMouse.swift
index a69c36b9..e398410f 100644
--- a/Sources/OmniWM/Core/Controller/MouseEventHandler+FocusFollowsMouse.swift
+++ b/Sources/OmniWM/Core/Controller/MouseEventHandler+FocusFollowsMouse.swift
@@ -470,3 +470,42 @@ enum FocusFollowsMouseTrailingEdge {
 
     static func cancel() { pending?.cancel(); pending = nil }
 }
+
+/// Focus follows the mouse also when the windows move under a still pointer (workspace switch, Niri scroll):
+/// mouse-move events alone never re-evaluated the window under the pointer then, so the window under it
+/// stayed unfocused until the mouse moved (2026-10-16). Marked when the workspace changes or a Niri scroll
+/// ends, evaluated once the layout refresh has completed and no swipe is running.
+@MainActor
+enum PointerFocusReevaluation {
+    private(set) static var pendingReason: StaticString?
+    static func markPending(reason: StaticString) { pendingReason = reason }
+    static func take() -> StaticString? { defer { pendingReason = nil }; return pendingReason }
+
+    /// Topmost normal window containing `point` (global top-left coordinates, like CGEvent locations).
+    static func windowId(at point: CGPoint) -> Int? {
+        guard let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly, .excludeDesktopElements], kCGNullWindowID)
+            as? [[String: Any]] else { return nil }
+        for info in list where (info[kCGWindowLayer as String] as? Int) == 0 {
+            guard let bounds = info[kCGWindowBounds as String] as? [String: CGFloat],
+                  CGRect(x: bounds["X"] ?? 0, y: bounds["Y"] ?? 0,
+                         width: bounds["Width"] ?? 0, height: bounds["Height"] ?? 0).contains(point)
+            else { continue }
+            return info[kCGWindowNumber as String] as? Int
+        }
+        return nil
+    }
+}
+
+extension MouseEventHandler {
+    func reevaluatePointerFocusIfPending() {
+        guard let controller, PointerFocusReevaluation.pendingReason != nil,
+              controller.isEnabled, controller.focusFollowsMouseEnabled, !controller.isOverviewOpen(),
+              let location = CGEvent(source: nil)?.location
+        else { return }
+        guard !shouldBlockOwnWindowInput(at: location), shouldHandleFocusFollowsMouse(at: location) else { return }
+        _ = PointerFocusReevaluation.take()
+        FocusTrace.decision("re-evaluate under a still pointer", controller: controller)
+        state.lastFocusFollowsMouseTime = .distantPast   // not a mouse move: the debounce does not apply
+        handleFocusFollowsMouse(at: location, windowIdUnderPointer: PointerFocusReevaluation.windowId(at: location))
+    }
+}
