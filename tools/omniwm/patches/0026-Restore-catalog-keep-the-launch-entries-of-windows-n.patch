From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: YamadaBlog <118530756+YamadaBlog@users.noreply.github.com>
Date: Fri, 16 Oct 2026 17:03:36 +0200
Subject: [PATCH 25/30] Restore catalog: keep the launch entries of windows not
 seen again this session

A save made while the screen was locked found no window and wrote an empty catalog; the next launch
then put every window on the active workspace. Entries of the boot catalog not yet consumed by this
session are kept in every save.
---
 .../PersistedRestoreCatalogStore.swift        | 16 ++++++++--
 .../PersistedRestoreStartupGateTests.swift    | 30 +++++++++++++++++++
 2 files changed, 44 insertions(+), 2 deletions(-)

diff --git a/Sources/OmniWM/Core/Reconcile/PersistedRestoreCatalogStore.swift b/Sources/OmniWM/Core/Reconcile/PersistedRestoreCatalogStore.swift
index 7795c64c..c2234be0 100644
--- a/Sources/OmniWM/Core/Reconcile/PersistedRestoreCatalogStore.swift
+++ b/Sources/OmniWM/Core/Reconcile/PersistedRestoreCatalogStore.swift
@@ -148,7 +148,19 @@ final class PersistedRestoreCatalogStore {
         guard isReady else { return }
         markDirty()
         dirty = false
-        save(PersistedWindowRestoreCatalogBuilder.build(from: buildSnapshot()))
+        save(keepingUnseenBootEntries(PersistedWindowRestoreCatalogBuilder.build(from: buildSnapshot())))
+    }
+
+    /// Windows known at launch that this session has not seen again (locked screen, app not yet relaunched) keep
+    /// their entry: a save made while the screen was locked found no window and wrote an empty catalog, and the
+    /// next launch put every window on the active workspace (2026-10-16).
+    private func keepingUnseenBootEntries(_ catalog: PersistedWindowRestoreCatalog) -> PersistedWindowRestoreCatalog {
+        let present = Set(catalog.entries.map(\.key))
+        let unseen = bootCatalog.entries.filter {
+            !consumedBootEntries.contains(PersistedWindowRestoreConsumptionKey(entry: $0)) && !present.contains($0.key)
+        }
+        guard !unseen.isEmpty else { return catalog }
+        return PersistedWindowRestoreCatalog(entries: catalog.entries + unseen)
     }
 
     private func markDirty() {
@@ -190,7 +202,7 @@ final class PersistedRestoreCatalogStore {
     private func completeBuild(_ catalog: PersistedWindowRestoreCatalog, revision: UInt64) {
         buildInFlight = false
         if revision == self.revision, !dirty {
-            save(catalog)
+            save(keepingUnseenBootEntries(catalog))
             return
         }
         if dirty {
diff --git a/Tests/OmniWMTests/PersistedRestoreStartupGateTests.swift b/Tests/OmniWMTests/PersistedRestoreStartupGateTests.swift
index cf2c45e5..28c21512 100644
--- a/Tests/OmniWMTests/PersistedRestoreStartupGateTests.swift
+++ b/Tests/OmniWMTests/PersistedRestoreStartupGateTests.swift
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 // Copyright (C) 2026 BarutSRB — https://github.com/OmniNull/OmniWM
 
+import ApplicationServices
 @testable import OmniWM
 import XCTest
 
@@ -26,4 +27,33 @@ final class PersistedRestoreStartupGateTests: XCTestCase {
         store.flushNow()
         XCTAssertEqual(saves, 2)
     }
+
+    /// A save made while no window is visible (locked screen) must keep the windows known at launch.
+    func testSaveKeepsBootEntriesNotSeenThisSession() throws {
+        let metadata = ManagedReplacementMetadata(
+            bundleId: "com.apple.Safari", workspaceId: WorkspaceDescriptor.ID(), mode: .tiling,
+            role: kAXWindowRole as String, subrole: kAXStandardWindowSubrole as String, title: "Web",
+            windowLevel: 0, parentWindowId: nil, frame: nil
+        )
+        let entry = PersistedWindowRestoreEntry(
+            key: try XCTUnwrap(PersistedWindowRestoreKey(metadata: metadata)),
+            identity: try XCTUnwrap(PersistedWindowRestoreIdentity(token: WindowToken(pid: 46_911, windowId: 44_520), metadata: metadata)),
+            restoreIntent: PersistedRestoreIntent(
+                workspaceName: "2", topologyProfile: TopologyProfile(sortedMonitors: []), preferredMonitor: nil,
+                floatingFrame: nil, normalizedFloatingOrigin: nil, restoreToFloating: false, rescueEligible: false
+            )
+        )
+        var saved: [PersistedWindowRestoreCatalog] = []
+        let store = PersistedRestoreCatalogStore(
+            bootCatalog: PersistedWindowRestoreCatalog(entries: [entry]),
+            buildSnapshot: { RestoreCatalogBuildSnapshot(entries: []) },
+            save: { saved.append($0) }
+        )
+        store.flushNow()
+        XCTAssertEqual(saved.last?.entries, [entry], "unseen window keeps its workspace")
+
+        store.noteConsumed(PersistedWindowRestoreConsumptionKey(entry: entry))
+        store.flushNow()
+        XCTAssertEqual(saved.last?.entries, [], "once restored, the live world is the source of truth")
+    }
 }
