+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 BarutSRB — https://github.com/OmniNull/OmniWM
+
+import Darwin
+import Foundation
+
+/// A Chrome or Edge that a script launched for automation follows the rules of the test browser (Chrome for
+/// Testing), not the user's browser: otherwise its windows were tiled over the user's workspace. A driver talks to
+/// it through a pipe (Playwright `channel: "chrome"`: `--remote-debugging-pipe`, no `--enable-automation`) or a port
+/// it picks (`--remote-debugging-port=0`, Puppeteer, Selenium, both with `--enable-automation`). The user's browser
+/// has none of these; a browser the user signs in to through a fixed debugging port (9444) stays theirs.
+@MainActor
+enum AutomationBrowser {
+    static let ruleBundleId = "com.google.chrome.for.testing"
+    private static let browserBundlePrefixes = ["com.google.chrome", "com.microsoft.edgemac", "com.brave.browser"]
+
+    /// Replaced by tests.
+    static var isLaunchedForAutomation: (pid_t) -> Bool = { pid in cachedArgumentCheck(pid) }
+
+    /// The bundle id the window rules see for an app.
+    static func ruleBundleId(pid: pid_t, bundleId: String?) -> String? {
+        guard let bundleId else { return nil }
+        let lowered = bundleId.lowercased()
+        guard lowered != ruleBundleId,
+              browserBundlePrefixes.contains(where: { lowered.hasPrefix($0) }),
+              isLaunchedForAutomation(pid)
+        else { return bundleId }
+        return ruleBundleId
+    }
+
+    static func ruleFacts(_ facts: WindowRuleFacts, pid: pid_t) -> WindowRuleFacts {
+        let mapped = ruleBundleId(pid: pid, bundleId: facts.ax.bundleId)
+        guard mapped != facts.ax.bundleId else { return facts }
+        let ax = facts.ax
+        return WindowRuleFacts(
+            appName: facts.appName,
+            ax: AXWindowFacts(
+                role: ax.role,
+                subrole: ax.subrole,
+                title: ax.title,
+                hasCloseButton: ax.hasCloseButton,
+                hasFullscreenButton: ax.hasFullscreenButton,
+                fullscreenButtonEnabled: ax.fullscreenButtonEnabled,
+                hasZoomButton: ax.hasZoomButton,
+                hasMinimizeButton: ax.hasMinimizeButton,
+                appPolicy: ax.appPolicy,
+                bundleId: mapped,
+                attributeFetchSucceeded: ax.attributeFetchSucceeded,
+                isMain: ax.isMain,
+                isModal: ax.isModal
+            ),
+            sizeConstraints: facts.sizeConstraints,
+            windowServer: facts.windowServer
+        )
+    }
+
+    /// Keyed by pid and start time: a reused pid is a different process.
+    private static var cache: [String: Bool] = [:]
+
+    private static func cachedArgumentCheck(_ pid: pid_t) -> Bool {
+        guard let start = startTime(pid) else { return false }
+        let key = "\(pid)-\(start)"
+        if let known = cache[key] { return known }
+        if cache.count > 512 { cache.removeAll() }
+        let result = isAutomation(arguments: arguments(pid) ?? [])
+        cache[key] = result
+        return result
+    }
+
+    private static func startTime(_ pid: pid_t) -> UInt64? {
+        var info = kinfo_proc()
+        var size = MemoryLayout<kinfo_proc>.stride
+        var mib: [Int32] = [CTL_KERN, KERN_PROC, KERN_PROC_PID, pid]
+        guard sysctl(&mib, 4, &info, &size, nil, 0) == 0, size > 0 else { return nil }
+        let tv = info.kp_proc.p_un.__p_starttime
+        return UInt64(tv.tv_sec) * 1_000_000 + UInt64(tv.tv_usec)
+    }
+
+    static func isAutomation(arguments: [String]) -> Bool {
+        arguments.contains { ["--enable-automation", "--remote-debugging-pipe", "--remote-debugging-port=0"].contains($0) }
+    }
+
+    /// argv of a process (KERN_PROCARGS2: argc, executable path, padding, then the arguments).
+    static func arguments(_ pid: pid_t) -> [String]? {
+        var mib: [Int32] = [CTL_KERN, KERN_PROCARGS2, pid]
+        var size = 0
+        guard sysctl(&mib, 3, nil, &size, nil, 0) == 0, size > MemoryLayout<Int32>.size else { return nil }
+        var buffer = [UInt8](repeating: 0, count: size)
+        guard sysctl(&mib, 3, &buffer, &size, nil, 0) == 0 else { return nil }
+        let argc = buffer.withUnsafeBytes { $0.load(as: Int32.self) }
+        var index = MemoryLayout<Int32>.size
+        while index < size, buffer[index] != 0 { index += 1 }   // executable path
+        while index < size, buffer[index] == 0 { index += 1 }   // padding
+        var args: [String] = []
+        while index < size, args.count < Int(argc) {
+            let begin = index
+            while index < size, buffer[index] != 0 { index += 1 }
+            args.append(String(decoding: buffer[begin ..< index], as: UTF8.self))
+            index += 1
+        }
+        return args
+    }
+}
diff --git a/Tests/OmniWMTests/AutomationBrowserRuleTests.swift b/Tests/OmniWMTests/AutomationBrowserRuleTests.swift
new file mode 100644
index 00000000..0d749cc2
--- /dev/null
+++ b/Tests/OmniWMTests/AutomationBrowserRuleTests.swift
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (C) 2026 BarutSRB — https://github.com/OmniNull/OmniWM
+
+import AppKit
+@testable import OmniWM
+import XCTest
+
+@MainActor
+final class AutomationBrowserRuleTests: XCTestCase {
+    private var saved: ((pid_t) -> Bool)!
+
+    override func setUp() async throws {
+        saved = AutomationBrowser.isLaunchedForAutomation
+    }
+
+    override func tearDown() async throws {
+        AutomationBrowser.isLaunchedForAutomation = saved
+    }
+
+    private func facts(bundleId: String?) -> WindowRuleFacts {
+        WindowRuleFacts(
+            appName: "Browser",
+            ax: AXWindowFacts(
+                role: kAXWindowRole as String,
+                subrole: kAXStandardWindowSubrole as String,
+                title: "about:blank",
+                hasCloseButton: true,
+                hasFullscreenButton: true,
+                fullscreenButtonEnabled: true,
+                hasZoomButton: true,
+                hasMinimizeButton: true,
+                appPolicy: .regular,
+                bundleId: bundleId,
+                attributeFetchSucceeded: true
+            ),
+            sizeConstraints: nil,
+            windowServer: nil
+        )
+    }
+
+    func testAutomatedChromeFollowsTheTestBrowserRules() {
+        AutomationBrowser.isLaunchedForAutomation = { _ in true }
+        for bundleId in ["com.google.Chrome", "com.google.Chrome.canary", "com.microsoft.edgemac", "com.brave.Browser"] {
+            XCTAssertEqual(AutomationBrowser.ruleFacts(facts(bundleId: bundleId), pid: 1).ax.bundleId,
+                           AutomationBrowser.ruleBundleId, bundleId)
+        }
+    }
+
+    func testUserBrowserAndOtherAppsKeepTheirBundleId() {
+        AutomationBrowser.isLaunchedForAutomation = { _ in false }
+        XCTAssertEqual(AutomationBrowser.ruleFacts(facts(bundleId: "com.google.Chrome"), pid: 1).ax.bundleId,
+                       "com.google.Chrome")
+        AutomationBrowser.isLaunchedForAutomation = { _ in true }
+        XCTAssertEqual(AutomationBrowser.ruleFacts(facts(bundleId: "com.apple.Safari"), pid: 1).ax.bundleId,
+                       "com.apple.Safari")
+        XCTAssertNil(AutomationBrowser.ruleFacts(facts(bundleId: nil), pid: 1).ax.bundleId)
+    }
+
+    func testRecognisesTheDriversArguments() {
+        let chrome = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
+        // Recorded on 2026-10-30.
+        let playwright = [chrome, "--disable-field-trial-config", "--no-sandbox",
+                          "--user-data-dir=/var/folders/tc/x/T/playwright_chromiumdev_profile-VaNUsN",
+                          "--remote-debugging-pipe", "about:blank"]
+        let puppeteer = [chrome, "--enable-automation", "--remote-debugging-port=0",
+                         "--user-data-dir=/var/folders/tc/x/T/puppeteer_dev_chrome_profile-Ab12"]
+        let userChrome = [chrome, "--profile-directory=Default", "--restart"]
+        let signInChrome = [chrome, "--no-startup-window", "--no-default-browser-check", "--no-first-run",
+                            "--remote-debugging-port=9444", "--user-data-dir=/Users/u/.business-lover/navigateur"]
+        XCTAssertTrue(AutomationBrowser.isAutomation(arguments: playwright))
+        XCTAssertTrue(AutomationBrowser.isAutomation(arguments: puppeteer))
+        XCTAssertFalse(AutomationBrowser.isAutomation(arguments: userChrome))
+        XCTAssertFalse(AutomationBrowser.isAutomation(arguments: signInChrome))
+    }
+
+    func testReadsTheArgumentsOfARealProcess() throws {
+        let child = Process()
+        child.executableURL = URL(fileURLWithPath: "/bin/sh")
+        child.arguments = ["-c", "sleep 5", "--enable-automation"]
+        try child.run()
+        defer { child.terminate() }
+        XCTAssertEqual(AutomationBrowser.arguments(child.processIdentifier)?.last, "--enable-automation")
+        XCTAssertTrue(saved(child.processIdentifier))
+        XCTAssertFalse(saved(ProcessInfo.processInfo.processIdentifier))
+    }
+}
