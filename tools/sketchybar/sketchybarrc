#!/usr/bin/env bash
# SketchyBar, "pills" style, geek edition (2026-11-04). It takes the band of the macOS menu bar (auto-hidden, 39 pt on
# this screen, notch 222 pt in the middle), one glass pill per group:
#   left   workspaces with the app icons of their windows (sketchybar-app-font), focused window
#   right  CPU graph + %, GPU %, memory, network down/up | sound, Wi-Fi, battery | date and time
#   popups click CPU: busiest processes and memory-guard; click the clock: the month
# Colours: colors.sh, written by Home Manager from the wallpaper palette (home-manager/sketchybar.nix). OmniWM events
# come from `omniwmctl watch` (custom event omniwm_update). topmost=on puts the bar at window level 25, above the
# macOS menu bar (24) that still slides in when the pointer touches the top edge ("window" = level 3, under it).
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGINS="$CONFIG_DIR/plugins"
# shellcheck source=/dev/null
source "$CONFIG_DIR/colors.sh"
CTL="$HOME/.local/bin/omniwmctl"
FONT="JetBrainsMono Nerd Font"
APPFONT="sketchybar-app-font:Regular:14.0"

# Background: the top strip of the wallpaper (scripts/bar-strip.py, regenerated by theme-apply.sh at each wallpaper
# change). It hides the macOS menu bar, which still slides in under this bar (level 25 over 24) at the top edge, and
# the bar still looks transparent. Tried 2026-11-05: an opaque band (read as a grey strip) and keeping the pointer off
# the top edge (macOS revealed the menu bar anyway).
STRIP="$HOME/.cache/macos-config/bar-strip.png"
sketchybar --bar position=top height=39 color=0x00000000 border_width=0 shadow=off sticky=on topmost=on \
                 padding_left=8 padding_right=8 margin=0 y_offset=0 notch_width=222 display=main
[ -f "$STRIP" ] && sketchybar --bar image="$STRIP" image.scale=0.5 image.drawing=on

sketchybar --default updates=when_shown \
                     icon.font="$FONT:Bold:14.0" label.font="$FONT:Medium:13.0" \
                     icon.color="$TEXT" label.color="$TEXT" \
                     icon.padding_left=4 icon.padding_right=4 label.padding_left=4 label.padding_right=4 \
                     padding_left=2 padding_right=2 background.height=28 \
                     popup.background.color="$POPUP" popup.background.border_color="$BORDER" popup.background.border_width=1 \
                     popup.background.corner_radius=12 popup.blur_radius=30 popup.y_offset=6

pill() {  # $1 bracket name, $2 fill, $3 border, rest: members
  local name=$1 fill=$2 border=$3; shift 3
  sketchybar --add bracket "$name" "$@" \
             --set "$name" background.color="$fill" background.border_color="$border" background.border_width=1 \
                           background.corner_radius=14 background.height=28 background.drawing=on
}

gap() {  # $1 name, $2 side: empty space between two pills
  sketchybar --add item "$1" "$2" --set "$1" width=10 icon.drawing=off label.drawing=off background.drawing=off
}

sketchybar --add event omniwm_update

# ---- Left: power button (lock, sleep, restart, shut down; macOS confirms restart and shut down).
sketchybar --add item session left \
           --set session icon="⏻" icon.font="$FONT:Bold:15.0" icon.color="$ACCENT" icon.padding_left=11 \
                         icon.padding_right=11 label.drawing=off popup.height=24 script="$PLUGINS/session.sh" \
           --subscribe session mouse.clicked mouse.exited.global
for a in "lock:󰌾:Verrouiller" "sleep:󰒲:Suspendre" "restart:󰜉:Redémarrer" "shutdown:󰐥:Éteindre"; do
  IFS=: read -r id ic lb <<<"$a"
  sketchybar --add item "session.$id" popup.session \
             --set "session.$id" icon="$ic" label="$lb" icon.padding_left=12 label.padding_right=14 background.height=22 \
                   click_script="$PLUGINS/session.sh $id"
done
pill session.pill "$PILL" "$BORDER" session
gap gap.l0 left

# ---- Left: workspaces, each with the icons of its apps; the current one gets an accent chip.
for n in 1 2 3 4; do
  sketchybar --add item "ws.$n" left \
             --set "ws.$n" icon="$n" icon.font="$FONT:ExtraBold:13.0" icon.padding_left=9 icon.padding_right=3 \
                           label.font="$APPFONT" label.padding_left=2 label.padding_right=9 label.y_offset=-1 \
                           background.height=22 background.corner_radius=9 background.color=0x00000000 \
                           click_script="$CTL command switch-workspace $n" script="$PLUGINS/hover.sh" \
             --subscribe "ws.$n" mouse.entered mouse.exited
done
sketchybar --add item ws.logic left \
           --set ws.logic drawing=off updates=on script="$PLUGINS/workspaces.sh" \
           --subscribe ws.logic omniwm_update system_woke
sketchybar --set ws.1 padding_left=6 --set ws.4 padding_right=6   # the 1 and the 4 off the pill's edges
pill ws "$PILL" "$BORDER" ws.1 ws.2 ws.3 ws.4
gap gap.l1 left

sketchybar --add item title left \
           --set title icon.font="$APPFONT" icon.color="$ACCENT" icon.padding_left=12 label.padding_right=12 \
                       label.max_chars=34 updates=on script="$PLUGINS/title.sh" \
           --subscribe title omniwm_update front_app_switched system_woke
pill title.pill "$PILL" "$BORDER" title
gap gap.l2 left
sketchybar --add item media left \
           --set media icon.padding_left=12 label.padding_right=12 label.max_chars=28 update_freq=5 \
                       script="$PLUGINS/media.sh" drawing=off \
           --subscribe media mouse.clicked system_woke
pill media.pill "$PILL" "$BORDER" media
gap gap.l3 left
# Fans and energy mode (tools/fans), left of the notch: the right half is full.
sketchybar --add item fan left \
           --set fan icon="󰈐" icon.color="$ACCENT" update_freq=5 script="$PLUGINS/fan.sh" popup.height=24 \
           --subscribe fan mouse.clicked mouse.exited.global system_woke
for m in "auto:Automatique (macOS)" "eco:Économie (basse consommation)" "equilibre:Équilibré (ventilation plus tôt)" \
         "perf:Performance (haute puissance)" "max:Maximum (ventilos à fond)"; do
  sketchybar --add item "fan.mode.${m%%:*}" popup.fan \
             --set "fan.mode.${m%%:*}" label="${m#*:}" icon.padding_left=12 label.padding_right=14 background.height=22 \
                   click_script="$PLUGINS/fan.sh ${m%%:*}"
done
pill fan.pill "$PILL" "$BORDER" fan

# ---- Right (added right to left): clock, system, stats.
sketchybar --add item clock right \
           --set clock icon="󰃭" icon.color="$ACCENT" icon.padding_left=12 label.font="$FONT:Bold:13.0" label.padding_right=12 \
                       update_freq=15 script="$PLUGINS/clock.sh" click_script="$PLUGINS/calendar.sh" popup.height=24 \
           --subscribe clock system_woke mouse.exited.global
for i in 0 1 2 3 4 5 6 7; do
  sketchybar --add item "clock.cal.$i" popup.clock \
             --set "clock.cal.$i" icon.drawing=off label.font="$FONT:Medium:12.5" label.width=190 label.align=left \
                                  label.padding_left=16 label.padding_right=10 background.height=20
done
pill clock.pill "$PILL_ACC" "$BORDER_ACC" clock
gap gap.r1 right

sketchybar --add item battery right \
           --set battery update_freq=120 label.padding_right=12 script="$PLUGINS/battery.sh" \
           --subscribe battery power_source_change system_woke \
           --add item vpn right \
           --set vpn icon="󰦝" label.font="$FONT:Bold:12.0" update_freq=10 script="$PLUGINS/vpn.sh" drawing=off \
           --subscribe vpn wifi_change system_woke \
           --add item wifi right \
           --set wifi label.drawing=off script="$PLUGINS/wifi.sh" popup.height=24 \
           --subscribe wifi wifi_change system_woke mouse.clicked mouse.exited.global \
           --add item volume right \
           --set volume icon.padding_left=12 script="$PLUGINS/volume.sh" \
           --subscribe volume volume_change
pill system "$PILL" "$BORDER" volume wifi vpn battery
gap gap.r2 right

# Stats: one updater (stats.sh, every 2 s) sets all of them; the CPU graph scrolls with each sample.
sketchybar --add item power right \
           --set power icon="󱐋" icon.color="$ACCENT" label.padding_right=12 update_freq=5 script="$PLUGINS/power.sh" \
           --subscribe power system_woke \
           --add item net right \
           --set net icon="󰇚" icon.color="$OK" label.font="$FONT:Medium:12.0" label.width=135 label.align=left \
           --add item mem right \
           --set mem icon="󰍛" \
           --add item gpu right \
           --set gpu icon="󰢮" click_script="$HOME/.local/bin/geek-monitor macmon" \
           --add item cpu right \
           --set cpu icon="" icon.color="$ACCENT" label.width=40 label.align=right \
                     click_script="$PLUGINS/top.sh" script="$PLUGINS/popup-close.sh" popup.height=26 \
           --subscribe cpu mouse.exited.global \
           --add graph cpu.graph right 44 \
           --set cpu.graph graph.color="$ACCENT" graph.fill_color="$GRAPH_FILL" graph.line_width=1.2 \
                           background.height=18 background.color=0x00000000 padding_left=12 padding_right=0 \
                           update_freq=2 updates=on script="$PLUGINS/stats.sh" \
           --subscribe cpu.graph system_woke
for i in 0 1 2 3 4 5 6; do
  sketchybar --add item "cpu.top.$i" popup.cpu \
             --set "cpu.top.$i" icon.font="$FONT:Bold:12.5" label.font="$FONT:Medium:12.5" \
                                icon.width=62 icon.align=right icon.padding_left=10 label.padding_left=10 \
                                label.padding_right=14 background.height=22
done
pill stats "$PILL" "$BORDER" cpu.graph cpu gpu mem net power

# OmniWM events -> omniwm_update (one watcher; a reload replaces it).
pkill -f "omniwmctl watch focus,active-workspace,windows-changed" 2>/dev/null
SB="$(command -v sketchybar)"
nohup "$CTL" watch focus,active-workspace,windows-changed --exec "$SB" --trigger omniwm_update >/dev/null 2>&1 &

sketchybar --update
sketchybar --trigger omniwm_update
