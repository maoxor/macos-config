# One theme everywhere: a base16 palette generated from the wallpaper (wallpapers/actuel.png), see palette.nix.
# Stylix's own generation gave 8 pink accents (errors/success/diff indistinguishable): background and text
# come from the image, accents are distinct hues pulled towards the image.
# autoEnable = false: only the targets listed here are themed.
{ config, pkgs, lib, ... }:
let
  profile = import ./profile.nix;
  # opacity: saved with each palette (home-manager/palettes); palettes from before it existed used 0.94.
  palette = import ./palette.nix;
in {
  stylix = {
    enable = true;
    image = ../wallpapers/actuel.png;
    polarity = if profile.lightTheme then "light" else "dark";
    autoEnable = false;
    # Readable palette generated from the image by scripts/palette-from-image.py (distinct accents, contrast >= 4.5:1).
    # Regenerated when the wallpaper changes (theme-auto agent) or by scripts/theme-sync.sh.
    base16Scheme = builtins.removeAttrs palette [ "opacity" ];
    # Keep Ghostty's font and transparency (Stylix would otherwise force DejaVu and opacity 1).
    fonts.monospace = { package = pkgs.jetbrains-mono; name = "JetBrains Mono"; };
    fonts.sizes.terminal = 13;
    opacity.terminal = palette.opacity or 0.94;
    targets = {
      ghostty.enable = true;
      starship.enable = true;
      bat.enable = true;
      fzf.enable = true;
      lazygit.enable = true;
      yazi.enable = true;
      btop.enable = true;
    };
  };

  # Read by scripts/palette-from-image.py: generate the light variant of the palette.
  xdg.configFile."macos-config/theme-light" = lib.mkIf profile.lightTheme { text = ""; };

  # Colours for Hammerspoon (context alerts), generated from the same palette.
  home.file.".hammerspoon/poweruser-colors.lua".text = let c = config.lib.stylix.colors.withHashtag; in ''
    -- Generated by Home Manager (home-manager/theme.nix) from the Stylix palette: do not edit.
    return { bg = "${c.base00}", surface = "${c.base01}", text = "${c.base05}", accent = "${c.base0D}", blue = "${c.base0D}" }
  '';

  # Themed programs are managed by Home Manager (Stylix only themes HM programs).
  programs.bat.enable = true;
  programs.lazygit.enable = true;
  programs.yazi.enable = true;
  programs.btop.enable = true;
  programs.ghostty = {
    enable = true;
    package = null; # the app itself comes from Homebrew (cask ghostty)
    settings = {
      # Written by scripts/ghostty-live-colors.py before the build, so a new theme shows at once; optional (?).
      config-file = "?live-colors";
      window-save-state = "always";   # windows come back after a restart or crash
      window-padding-x = 12;
      window-padding-y = 10;
      background-blur = true;
      # Stylix converts the size to px (x4/3 = 17.3) while Ghostty on macOS expects points: keep 13.
      font-size = lib.mkForce 13;
      # No macOS notification from the terminal (owner, 2026-11-12: Claude Code sessions kept posting alerts that
      # stayed on screen). Applies to OSC 9/777 notifications from any program running in Ghostty.
      desktop-notifications = false;
    };
  };
}
